---
import Editor from './Editor.astro'
import GitHub from './ui/GitHub.astro'
import Logo from './ui/Logo.astro'
import Reset from './ui/Reset.astro'
import Sharable from './ui/Sharable.astro'
import Splitter from './ui/Splitter.tsx'
import ThemeToggle from './ui/Toggle.vue'
import VersionSelect from './ui/VersionSelect.astro'
import FrameworkSelect from './ui/FrameworkSelect.astro'
import '../styles/tab.css'
---

<!-- Loading Overlay -->
<div id="loading-overlay" class="fixed inset-0 z-9999 flex items-center justify-center bg-background transition-opacity duration-300">
  <div class="flex flex-col items-center gap-4">
    <div class="loading-spinner"></div>
    <div class="text-primary text-lg font-medium">Loading Playground...</div>
    <div class="text-muted-foreground text-sm">Initializing editor and modules</div>
  </div>
</div>

<div class="flex flex-col h-100vh bg-background text-primary" id="playground">
  <!-- header -->
  <nav class="flex text-primary bg-background h-[--nav-height] box-border shadow-[0_0_4px_#00000054] relative z-999 justify-between px-[1em] py-0">
    <!-- title -->
    <h1 class="font-medium inline-flex place-items-center">
      <Logo />
      <span>
        Destyler Playground
      </span>
    </h1>
    <!-- links -->
    <div class="flex">
      <VersionSelect />
      <FrameworkSelect />
      <ThemeToggle client:only="vue" />
      <Sharable />
      <Reset />
      <GitHub />
    </div>
  </nav>

  <!-- Main Content -->
  <Splitter client:only="react">
    <!-- Editor Section -->
    <div data-panel="editor" class="flex border-r border-r-solid border-r-border flex-1 flex-col min-w-0 h-full">
      <!-- File Tabs -->
      <div class="flex bg-background border-b border-b-solid border-b-border">
        <div class="flex overflow-x-auto flex-1" id="file-tabs" />
        <div class="flex items-center border-l border-l-solid border-l-border ml-auto" id="config-tabs">
          <button class="config-tab" id="uno-config-btn" title="uno.config.ts (UnoCSS)">
            <span class="i-catppuccin-unocss text-base" />
          </button>
          <button class="config-tab" id="import-map-btn" title="Import Map">
            <span class="i-catppuccin-package-json text-base" />
          </button>
          <button class="config-tab" id="tsconfig-btn" title="tsconfig.json">
            <span class="i-catppuccin-typescript-config text-base" />
          </button>
        </div>
      </div>

      <!-- Monaco Editor -->
      <Editor />
    </div>

    <!-- Preview -->
    <iframe
      data-panel="preview"
      id="preview-iframe"
      title="preview"
      class="size-full border-none bg-white"
      sandbox="allow-scripts allow-same-origin allow-modals"
    />
  </Splitter>
</div>

<script>
  import { initPlayground } from '../libs/playground'

  function initSplitterContent() {
    // Move content from hidden container to panels
    const editorContent = document.querySelector('[data-panel="editor"]')
    const previewContent = document.querySelector('[data-panel="preview"]')
    const editorPanel = document.getElementById('editor-panel')
    const previewPanel = document.getElementById('preview-panel')

    if (editorContent && editorPanel) {
      editorPanel.appendChild(editorContent)
    }
    if (previewContent && previewPanel) {
      previewPanel.appendChild(previewContent)
    }
  }

  function hideLoading() {
    const loadingOverlay = document.getElementById('loading-overlay')
    if (loadingOverlay) {
      loadingOverlay.style.opacity = '0'
      setTimeout(() => {
        loadingOverlay.style.display = 'none'
      }, 300)
    }
  }

  function waitForSplitter(): Promise<void> {
    return new Promise((resolve) => {
      const tryMove = () => {
        const editorPanel = document.getElementById('editor-panel')
        const previewPanel = document.getElementById('preview-panel')
        if (editorPanel && previewPanel) {
          initSplitterContent()
          resolve()
          return true
        }
        return false
      }

      if (tryMove())
        return

      window.addEventListener('splitter:ready', () => {
        tryMove()
      }, { once: true })
    })
  }

  async function init() {
    try {
      // Reparent editor/iframe into visible panels BEFORE assigning iframe srcdoc
      await waitForSplitter()
      window.addEventListener('playground:shell-ready', hideLoading, { once: true })
      await initPlayground()
      hideLoading()
    } catch (error) {
      console.error('[Playground] Initialization failed:', error)
      hideLoading()
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    init()
  })

  document.addEventListener('astro:page-load', () => {
    init()
  })
</script>
