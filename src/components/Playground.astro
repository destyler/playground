---
import Editor from './Editor.astro'
import ThemeToggle from '../ui/Toggle.vue'
import Logo from '../ui/Logo.astro'
import ThemeSelect from '../ui/Select.vue'
import GitHub from '../ui/GitHub.astro'
import Sharable from '../ui/Sharable.astro'
import Reset from '../ui/Reset.astro'
---

<div class="flex flex-col h-100vh bg-background text-white" id="playground">
  <!-- header -->
  <nav class="flex text-primary bg-background h-[--nav-height] box-border shadow-[0_0_4px_#00000054] relative z-[999] justify-between px-[1em] py-0">
    <!-- title -->
    <h1 class="font-medium inline-flex place-items-center">
      <Logo />
      <span>
        Destyler Playground
      </span>
    </h1>
    <!-- links -->
    <div class="flex">
      <ThemeSelect client:only="vue" />
      <ThemeToggle client:only="vue" />
      <Sharable />
      <Reset />
      <GitHub />
    </div>
  </nav>

  <!-- Main Content -->
  <div class="flex flex-1 overflow-hidden">
    <!-- Editor Section -->
    <div class="flex border-r border-r-solid border-r-gray/20 flex-1 flex-col min-w-0">
      <!-- File Tabs -->
      <div class="flex bg-dark border-b border-b-solid border-b-gray/20 overflow-x-auto" id="file-tabs" />

      <!-- Monaco Editor -->
      <Editor />
    </div>

    <!-- Preview -->
    <div class="flex bg-white">
      <iframe
        id="preview-iframe"
        title="preview"
        class="size-full border-none"
        sandbox="allow-scripts allow-same-origin allow-modals"
      />
    </div>
  </div>
</div>

<style>
  .file-tabs {
    display: flex;
    background-color: #252526;
    border-bottom: 1px solid #333;
    overflow-x: auto;
  }

  :global(.file-tab) {
    padding: 8px 12px;
    cursor: pointer;
    background-color: transparent;
    color: #999;
    border: none;
    border-right: 1px solid #333;
    border-top: 2px solid transparent;
    display: flex;
    align-items: center;
    font-size: 0.9rem;
    user-select: none;
    min-width: fit-content;
  }

  :global(.file-tab:hover) {
    color: #ccc;
  }

  :global(.file-tab.active) {
    background-color: #1e1e1e;
    color: #fff;
    border-top-color: #42b883;
  }

  :global(.file-tab-input) {
    background-color: #333;
    color: #fff;
    border: 1px solid #555;
    border-radius: 2px;
    padding: 2px 4px;
    font-size: 0.9rem;
    outline: none;
    width: 100px;
  }

  :global(.file-tab-close) {
    margin-left: 8px;
    font-size: 0.8rem;
    opacity: 0.6;
    cursor: pointer;
    background: none;
    border: none;
    color: inherit;
    padding: 0;
  }

  :global(.file-tab-close:hover) {
    opacity: 1;
  }

  :global(.add-file-btn) {
    background: none;
    border: none;
    color: #999;
    cursor: pointer;
    padding: 0 12px;
    font-size: 1.2rem;
    outline: none;
  }

  :global(.add-file-btn:hover) {
    color: #fff;
  }
</style>

<script>
  import { initPlayground } from '../libs/playground'

  document.addEventListener('DOMContentLoaded', initPlayground)
  document.addEventListener('astro:page-load', initPlayground)
</script>
