---
import { FRAMEWORKS } from '../utils/templates'
import Editor from './Editor.astro'

const frameworks = Object.entries(FRAMEWORKS).map(([key, config]) => ({
  key,
  name: config.name,
  color: config.color,
}))
---

<div class="playground" id="playground">
  <!-- Header -->
  <header class="header">
    <h2 class="title">Playground</h2>
    <div class="framework-buttons">
      {frameworks.map(({ key, name, color }) => (
        <button
          class="framework-btn"
          data-framework={key}
          data-color={color}
        >
          {name}
        </button>
      ))}
    </div>
  </header>

  <!-- Main Content -->
  <div class="main-content">
    <!-- Editor Section -->
    <div class="editor-section">
      <!-- File Tabs -->
      <div class="file-tabs" id="file-tabs"></div>

      <!-- Monaco Editor -->
      <Editor />
    </div>

    <!-- Preview -->
    <div class="preview-section">
      <iframe
        id="preview-iframe"
        title="preview"
        class="preview-iframe"
        sandbox="allow-scripts allow-same-origin allow-modals"
      ></iframe>
    </div>
  </div>
</div>

<style>
  .playground {
    display: flex;
    flex-direction: column;
    height: 100vh;
    background-color: #1e1e1e;
    color: #fff;
  }

  .header {
    display: flex;
    gap: 10px;
    padding: 10px 20px;
    border-bottom: 1px solid #333;
    align-items: center;
  }

  .title {
    margin: 0;
    margin-right: 20px;
    font-size: 1.2rem;
  }

  .framework-buttons {
    display: flex;
    gap: 10px;
  }

  .framework-btn {
    padding: 6px 12px;
    background-color: #333;
    color: #aaa;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
    transition: all 0.2s;
  }

  .framework-btn:hover {
    opacity: 0.8;
  }

  .framework-btn.active {
    color: #fff;
  }

  .main-content {
    display: flex;
    flex: 1;
    overflow: hidden;
  }

  .editor-section {
    flex: 1;
    border-right: 1px solid #333;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .file-tabs {
    display: flex;
    background-color: #252526;
    border-bottom: 1px solid #333;
    overflow-x: auto;
  }

  :global(.file-tab) {
    padding: 8px 12px;
    cursor: pointer;
    background-color: transparent;
    color: #999;
    border: none;
    border-right: 1px solid #333;
    border-top: 2px solid transparent;
    display: flex;
    align-items: center;
    font-size: 0.9rem;
    user-select: none;
    min-width: fit-content;
  }

  :global(.file-tab:hover) {
    color: #ccc;
  }

  :global(.file-tab.active) {
    background-color: #1e1e1e;
    color: #fff;
    border-top-color: #42b883;
  }

  :global(.file-tab-input) {
    background-color: #333;
    color: #fff;
    border: 1px solid #555;
    border-radius: 2px;
    padding: 2px 4px;
    font-size: 0.9rem;
    outline: none;
    width: 100px;
  }

  :global(.file-tab-close) {
    margin-left: 8px;
    font-size: 0.8rem;
    opacity: 0.6;
    cursor: pointer;
    background: none;
    border: none;
    color: inherit;
    padding: 0;
  }

  :global(.file-tab-close:hover) {
    opacity: 1;
  }

  :global(.add-file-btn) {
    background: none;
    border: none;
    color: #999;
    cursor: pointer;
    padding: 0 12px;
    font-size: 1.2rem;
    outline: none;
  }

  :global(.add-file-btn:hover) {
    color: #fff;
  }

  .preview-section {
    flex: 1;
    background-color: #fff;
  }

  .preview-iframe {
    width: 100%;
    height: 100%;
    border: none;
  }
</style>

<script>
  import { initPlayground } from '../libs/playground'

  document.addEventListener('DOMContentLoaded', initPlayground)
  document.addEventListener('astro:page-load', initPlayground)
</script>
