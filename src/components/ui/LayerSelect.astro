---
/**
 * Layer Select Component
 *
 * A dropdown select component for choosing Destyler (headless) vs Destyler UI.
 * Based on Vue SFC Playground's VersionSelect component style.
 *
 * Events:
 * - Dispatches 'layer:change' when user selects a different layer
 * - Listens for 'url:framework-restored' to sync with URL state
 */
---

<div class="mr-3 relative flex justify-center items-center" id="layer-select-container">
  <span
    class="cursor-pointer relative inline-flex place-items-center text-sm text-primary after:content-empty after:w-0 after:h-0 after:border-l-4 after:border-l-transparent after:border-r-4 after:border-r-transparent after:border-t-6 after:border-t-muted-foreground after:ml-2"
    id="layer-trigger"
  >
    <span class="text-accent-foreground font-medium" id="layer-label">Destyler</span>
  </span>

  <ul
    class="hidden absolute left-0 top-[--nav-height] bg-popover border border-solid border-border rounded list-none p-2 mt-1 m-0 w-36 z-99999"
    id="layer-dropdown"
  >
    <!-- Layer options will be rendered by script -->
  </ul>
</div>

<!-- Inline script to immediately update UI from URL before main script loads -->
<script is:inline src="https://cdn.jsdelivr.net/npm/pako@2.1.0/dist/pako.min.js"></script>
<script is:inline>
(function() {
  try {
    var hash = window.location.hash;
    if (!hash || hash === '#') return;

    var serializedState = hash.startsWith('#') ? hash.slice(1) : hash;
    var binary = atob(serializedState);

    var parsed;
    // Check if it's zlib compressed (starts with magic byte 0x78)
    if (binary.charCodeAt(0) === 0x78) {
      // Convert binary string to Uint8Array
      var bytes = new Uint8Array(binary.length);
      for (var i = 0; i < binary.length; i++) {
        bytes[i] = binary.charCodeAt(i);
      }
      // Decompress using pako
      var decompressed = window.pako.inflate(bytes, { to: 'string' });
      parsed = JSON.parse(decompressed);
    } else {
      // Try parsing as legacy unicode format
      var decoded = decodeURIComponent(escape(binary));
      parsed = JSON.parse(decoded);
    }

    if (parsed && parsed.layer) {
      var labelEl = document.getElementById('layer-label');
      var layerLabels = {
        destyler: 'Destyler',
        'destyler-ui': 'Destyler UI'
      };
      if (labelEl) {
        labelEl.textContent = layerLabels[parsed.layer] || 'Destyler';
      }
    }
  } catch (e) {
    console.error('Failed to parse URL state for layer:', e);
  }
})();
</script>

<script>
import type { PlaygroundLayer } from '../../templates/types'
import { strFromU8, strToU8, unzlibSync } from 'fflate'
import { LAYER_OPTIONS, state } from '../../libs/state'
import { parsePlaygroundLayer } from '../../templates/destyler-ui'

const EVENTS = {
  LAYER_CHANGE: 'layer:change',
  URL_FRAMEWORK_RESTORED: 'url:framework-restored',
  PLAYGROUND_STATE_READY: 'playground:state-ready',
} as const

const INIT_DELAY = 300

let expanded = false
let selectedLayer: PlaygroundLayer = state.activeLayer
let isInitializing = true

/**
 * Parse framework directly from URL hash
 */
function getLayerFromUrl(): PlaygroundLayer | null {
  try {
    const hash = window.location.hash
    if (!hash || hash === '#') return null

    const serializedState = hash.startsWith('#') ? hash.slice(1) : hash
    const binary = atob(serializedState)

    if (binary.charCodeAt(0) === 0x78) {
      const buffer = strToU8(binary, true)
      const unzipped = unzlibSync(buffer)
      const data = strFromU8(unzipped)
      const parsed = JSON.parse(data)
      return parsed.layer ? parsePlaygroundLayer(parsed.layer) : null
    }

    const decoded = decodeURIComponent(escape(binary))
    const parsed = JSON.parse(decoded)
    return parsed.layer ? parsePlaygroundLayer(parsed.layer) : null
  } catch {
    return null
  }
}

// ============================================================================
// IMMEDIATE INITIALIZATION - Run as soon as script loads
// ============================================================================
;(function immediateInit() {
  const urlLayer = getLayerFromUrl()

  if (urlLayer) {
    selectedLayer = urlLayer
    state.activeLayer = urlLayer
  }

  const labelEl = document.getElementById('layer-label')
  if (labelEl && selectedLayer) {
    const option = LAYER_OPTIONS.find(o => o.value === selectedLayer)
    labelEl.textContent = option?.label || 'Destyler'
  }
})();

function getElements() {
  return {
    container: document.getElementById('layer-select-container') as HTMLElement | null,
    trigger: document.getElementById('layer-trigger'),
    label: document.getElementById('layer-label'),
    dropdown: document.getElementById('layer-dropdown'),
  }
}

function updateUI() {
  const { label, dropdown } = getElements()

  if (label) {
    const option = LAYER_OPTIONS.find(o => o.value === selectedLayer)
    label.textContent = option?.label || 'Destyler'
  }

  if (dropdown) {
    if (expanded) {
      dropdown.classList.remove('hidden')
      dropdown.classList.add('block')
    } else {
      dropdown.classList.remove('block')
      dropdown.classList.add('hidden')
    }
  }
}

function renderLayerList() {
  const { dropdown } = getElements()
  if (!dropdown) return

  // Clear existing items
  dropdown.innerHTML = ''

  LAYER_OPTIONS.forEach((option) => {
    const isActive = option.value === selectedLayer
    const li = document.createElement('li')
    li.className = 'flex justify-between items-center'

    const a = document.createElement('a')
    a.className = 'block px-3 py-1.5 no-underline cursor-pointer text-popover-foreground/80 text-sm rounded hover:text-popover-foreground' + (isActive ? ' text-accent-foreground font-medium' : '')
    a.textContent = option.label
    a.addEventListener('click', (e) => {
      e.stopPropagation()
      setLayer(option.value)
    })

    li.appendChild(a)
    dropdown.appendChild(li)
  })
}

function setLayer(layer: PlaygroundLayer) {
  if (selectedLayer === layer) {
    expanded = false
    updateUI()
    return
  }

  selectedLayer = layer
  expanded = false
  updateUI()
  renderLayerList()

  if (!isInitializing) {
    window.dispatchEvent(
      new CustomEvent(EVENTS.LAYER_CHANGE, {
        detail: { layer },
      })
    )
  }
}

function toggle() {
  expanded = !expanded
  updateUI()
}

function handleClickOutside() {
  expanded = false
  updateUI()
}

function handleBlur() {
  if (document.activeElement && document.activeElement.tagName === 'IFRAME') {
    expanded = false
    updateUI()
  }
}

function handleUrlStateRestore(e: Event) {
  const customEvent = e as CustomEvent<{ layer?: PlaygroundLayer }>
  const layer = customEvent.detail.layer ? parsePlaygroundLayer(customEvent.detail.layer) : 'destyler'
  if (selectedLayer !== layer) {
    isInitializing = true
    selectedLayer = layer
    updateUI()
    renderLayerList()
    isInitializing = false
  }
}

function initLayerSelect() {
  const { trigger, container } = getElements()

  if (!trigger || !container) return

  // Prevent double initialization
  if ((container as any).__initialized) {
    return
  }
  (container as any).__initialized = true

  // First, try to read framework directly from URL (most reliable)
  const urlLayer = getLayerFromUrl()
  if (urlLayer) {
    selectedLayer = urlLayer
    state.activeLayer = urlLayer
  }

  renderLayerList()

  const labelEl = document.getElementById('layer-label')
  if (labelEl) {
    const option = LAYER_OPTIONS.find(o => o.value === selectedLayer)
    labelEl.textContent = option?.label || 'Destyler'
  }

  trigger.addEventListener('click', (e) => {
    e.stopPropagation()
    toggle()
  })

  window.addEventListener('click', handleClickOutside)
  window.addEventListener('blur', handleBlur)
  window.addEventListener(EVENTS.URL_FRAMEWORK_RESTORED, handleUrlStateRestore)

  // Listen for playground state ready event
  window.addEventListener(EVENTS.PLAYGROUND_STATE_READY, (e: Event) => {
    const customEvent = e as CustomEvent<{ layer?: PlaygroundLayer }>
    if (customEvent.detail.layer) {
      const layer = parsePlaygroundLayer(customEvent.detail.layer)
      if (selectedLayer !== layer) {
        isInitializing = true
        selectedLayer = layer
        updateUI()
        renderLayerList()
        isInitializing = false
      }
    }
  })

  // Mark initialization as complete after delay
  setTimeout(() => {
    isInitializing = false
  }, INIT_DELAY)
}

document.addEventListener('DOMContentLoaded', initLayerSelect)
document.addEventListener('astro:page-load', initLayerSelect)
</script>
