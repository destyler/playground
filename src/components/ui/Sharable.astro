---
---

<button
  id="share-btn"
  class="text-primary px-1.5 py-px ml-1 flex items-center cursor-pointer bg-transparent m-0 border-[none] [outline:none] op-60 hover:op-100"
  aria-label="Share this playground"
  title="Copy shareable link"
>
  <div class="i-ph-share-network-duotone" id="share-icon" />
</button>

<script>
import { state } from '../../libs/state'
import { copyShareableUrl, updateUrlHash } from '../../utils/url'

function initShareButton() {
  const shareBtn = document.getElementById('share-btn')
  const shareIcon = document.getElementById('share-icon')

  if (!shareBtn || !shareIcon)
    return

  // Avoid duplicate listeners
  if ((shareBtn as any).__initialized) {
    return
  }
  (shareBtn as any).__initialized = true

  shareBtn.addEventListener('click', async () => {
    // Force update URL immediately before copying (include config content)
    updateUrlHash(state.activeFramework, state.files, state.tsconfigContent, state.importMapContent)

    const success = await copyShareableUrl()

    if (success) {
      // Show success feedback
      const originalClass = shareIcon.className
      shareIcon.className = 'i-ph-check-duotone text-green-500'

      setTimeout(() => {
        shareIcon.className = originalClass
      }, 2000)
    }
    else {
      // Show error feedback
      const originalClass = shareIcon.className
      shareIcon.className = 'i-ph-x-duotone text-red-500'

      setTimeout(() => {
        shareIcon.className = originalClass
      }, 2000)
    }
  })
}

document.addEventListener('DOMContentLoaded', initShareButton)
document.addEventListener('astro:page-load', initShareButton)
</script>
