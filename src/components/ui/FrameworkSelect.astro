---
/**
 * Framework Select Component
 *
 * A dropdown select component for choosing the active framework in the playground.
 * Based on Vue SFC Playground's VersionSelect component style.
 *
 * Events:
 * - Dispatches 'framework:change' when user selects a different framework
 * - Listens for 'url:framework-restored' to sync with URL state
 */
---

<div class="mr-3 relative flex justify-center items-center" id="framework-select-container">
  <span
    class="cursor-pointer relative inline-flex place-items-center text-sm text-primary after:content-empty after:w-0 after:h-0 after:border-l-4 after:border-l-transparent after:border-r-4 after:border-r-transparent after:border-t-6 after:border-t-muted-foreground after:ml-2"
    id="framework-trigger"
  >
    <span class="text-accent-foreground font-medium" id="framework-label">Vue</span>
  </span>

  <ul
    class="hidden absolute left-0 top-[--nav-height] bg-popover border border-solid border-border rounded list-none p-2 mt-1 m-0 w-30 z-99999"
    id="framework-dropdown"
  >
    <!-- Framework options will be rendered by script -->
  </ul>
</div>

<!-- Inline script to immediately update UI from URL before main script loads -->
<script is:inline src="https://cdn.jsdelivr.net/npm/pako@2.1.0/dist/pako.min.js"></script>
<script is:inline>
(function() {
  try {
    var hash = window.location.hash;
    if (!hash || hash === '#') return;

    var serializedState = hash.startsWith('#') ? hash.slice(1) : hash;
    var binary = atob(serializedState);

    var parsed;
    // Check if it's zlib compressed (starts with magic byte 0x78)
    if (binary.charCodeAt(0) === 0x78) {
      // Convert binary string to Uint8Array
      var bytes = new Uint8Array(binary.length);
      for (var i = 0; i < binary.length; i++) {
        bytes[i] = binary.charCodeAt(i);
      }
      // Decompress using pako
      var decompressed = window.pako.inflate(bytes, { to: 'string' });
      parsed = JSON.parse(decompressed);
    } else {
      // Try parsing as legacy unicode format
      var decoded = decodeURIComponent(escape(binary));
      parsed = JSON.parse(decoded);
    }

    if (parsed && parsed.framework) {
      var labelEl = document.getElementById('framework-label');
      var frameworkLabels = {
        vue: 'Vue',
        react: 'React',
        solid: 'Solid',
        svelte: 'Svelte'
      };
      if (labelEl) {
        labelEl.textContent = frameworkLabels[parsed.framework] || parsed.framework;
      }
    }
  } catch (e) {
    console.error('Failed to parse URL state for framework:', e);
  }
})();
</script>

<script>
import type { Framework } from '../../templates/types'
import { strFromU8, strToU8, unzlibSync } from 'fflate'
import { FRAMEWORK_OPTIONS, state } from '../../libs/state'

const EVENTS = {
  FRAMEWORK_CHANGE: 'framework:change',
  URL_FRAMEWORK_RESTORED: 'url:framework-restored',
  PLAYGROUND_STATE_READY: 'playground:state-ready',
} as const

const INIT_DELAY = 300

let expanded = false
let selectedFramework: Framework = state.activeFramework
let isInitializing = true

/**
 * Parse framework directly from URL hash
 */
function getFrameworkFromUrl(): Framework | null {
  try {
    const hash = window.location.hash
    if (!hash || hash === '#') return null

    const serializedState = hash.startsWith('#') ? hash.slice(1) : hash
    const binary = atob(serializedState)

    // Check if it's zlib compressed (starts with magic byte 0x78)
    if (binary.charCodeAt(0) === 0x78) {
      const buffer = strToU8(binary, true)
      const unzipped = unzlibSync(buffer)
      const data = strFromU8(unzipped)
      const parsed = JSON.parse(data)
      return parsed.framework as Framework
    }

    // Fallback: try parsing as legacy unicode format
    const decoded = decodeURIComponent(escape(binary))
    const parsed = JSON.parse(decoded)
    return parsed.framework as Framework
  } catch {
    return null
  }
}

// ============================================================================
// IMMEDIATE INITIALIZATION - Run as soon as script loads
// ============================================================================
;(function immediateInit() {
  const urlFramework = getFrameworkFromUrl()

  if (urlFramework) {
    selectedFramework = urlFramework
    state.activeFramework = urlFramework
  }

  // Update DOM immediately if elements exist
  const labelEl = document.getElementById('framework-label')
  if (labelEl && selectedFramework) {
    const option = FRAMEWORK_OPTIONS.find(o => o.value === selectedFramework)
    labelEl.textContent = option?.label || selectedFramework
  }
})();

function getElements() {
  return {
    container: document.getElementById('framework-select-container') as HTMLElement | null,
    trigger: document.getElementById('framework-trigger'),
    label: document.getElementById('framework-label'),
    dropdown: document.getElementById('framework-dropdown'),
  }
}

function updateUI() {
  const { label, dropdown } = getElements()

  if (label) {
    const option = FRAMEWORK_OPTIONS.find(o => o.value === selectedFramework)
    label.textContent = option?.label || selectedFramework
  }

  if (dropdown) {
    if (expanded) {
      dropdown.classList.remove('hidden')
      dropdown.classList.add('block')
    } else {
      dropdown.classList.remove('block')
      dropdown.classList.add('hidden')
    }
  }
}

function renderFrameworkList() {
  const { dropdown } = getElements()
  if (!dropdown) return

  // Clear existing items
  dropdown.innerHTML = ''

  FRAMEWORK_OPTIONS.forEach((option) => {
    const isActive = option.value === selectedFramework
    const li = document.createElement('li')
    li.className = 'flex justify-between items-center'

    const a = document.createElement('a')
    a.className = 'block px-3 py-1.5 no-underline cursor-pointer text-popover-foreground/80 text-sm rounded hover:text-popover-foreground' + (isActive ? ' text-accent-foreground font-medium' : '')
    a.textContent = option.label
    a.addEventListener('click', (e) => {
      e.stopPropagation()
      setFramework(option.value)
    })

    li.appendChild(a)
    dropdown.appendChild(li)
  })
}

function setFramework(framework: Framework) {
  if (selectedFramework === framework) {
    expanded = false
    updateUI()
    return
  }

  selectedFramework = framework
  expanded = false
  updateUI()
  renderFrameworkList()

  if (!isInitializing) {
    // Reset version to latest when switching frameworks
    state.destylerVersion = 'latest'

    // Update version label in UI
    const versionLabel = document.getElementById('version-label')
    if (versionLabel) {
      versionLabel.textContent = 'latest'
    }

    // Dispatch version change event to update URL
    window.dispatchEvent(
      new CustomEvent('destyler:version-change', {
        detail: { version: 'latest' },
      })
    )

    window.dispatchEvent(
      new CustomEvent(EVENTS.FRAMEWORK_CHANGE, {
        detail: { framework },
      })
    )
  }
}

function toggle() {
  expanded = !expanded
  updateUI()
}

function handleClickOutside() {
  expanded = false
  updateUI()
}

function handleBlur() {
  if (document.activeElement && document.activeElement.tagName === 'IFRAME') {
    expanded = false
    updateUI()
  }
}

function handleUrlStateRestore(e: Event) {
  const customEvent = e as CustomEvent<{ framework: Framework }>
  const framework = customEvent.detail.framework
  if (framework && selectedFramework !== framework) {
    isInitializing = true
    selectedFramework = framework
    updateUI()
    renderFrameworkList()
    isInitializing = false
  }
}

function initFrameworkSelect() {
  const { trigger, container } = getElements()

  if (!trigger || !container) return

  // Prevent double initialization
  if ((container as any).__initialized) {
    return
  }
  (container as any).__initialized = true

  // First, try to read framework directly from URL (most reliable)
  const urlFramework = getFrameworkFromUrl()
  if (urlFramework) {
    selectedFramework = urlFramework
    state.activeFramework = urlFramework
  }

  // Initial render with correct framework
  renderFrameworkList()

  // Update UI immediately with URL data
  const labelEl = document.getElementById('framework-label')
  if (labelEl) {
    const option = FRAMEWORK_OPTIONS.find(o => o.value === selectedFramework)
    labelEl.textContent = option?.label || selectedFramework
  }

  trigger.addEventListener('click', (e) => {
    e.stopPropagation()
    toggle()
  })

  window.addEventListener('click', handleClickOutside)
  window.addEventListener('blur', handleBlur)
  window.addEventListener(EVENTS.URL_FRAMEWORK_RESTORED, handleUrlStateRestore)

  // Listen for playground state ready event
  window.addEventListener(EVENTS.PLAYGROUND_STATE_READY, (e: Event) => {
    const customEvent = e as CustomEvent<{ framework: Framework }>
    const framework = customEvent.detail.framework
    if (framework && selectedFramework !== framework) {
      isInitializing = true
      selectedFramework = framework
      updateUI()
      renderFrameworkList()
      isInitializing = false
    }
  })

  // Mark initialization as complete after delay
  setTimeout(() => {
    isInitializing = false
  }, INIT_DELAY)
}

document.addEventListener('DOMContentLoaded', initFrameworkSelect)
document.addEventListener('astro:page-load', initFrameworkSelect)
</script>
