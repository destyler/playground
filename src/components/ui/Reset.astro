<button
  id="reset-btn"
  class="text-primary px-1.5 py-px ml-1 flex items-center cursor-pointer bg-transparent m-0 border-[none] [outline:none] op-60 hover:op-100"
  aria-label="Refresh preview"
  title="Refresh preview"
>
  <div class="i-ph-arrows-counter-clockwise-light" id="reset-icon" />
</button>

<script>
  import { refreshPreview } from '../../libs/playground'

  function initResetButton() {
    const resetBtn = document.getElementById('reset-btn')
    const resetIcon = document.getElementById('reset-icon')

    if (!resetBtn || !resetIcon)
      return

    // Avoid duplicate listeners
    if ((resetBtn as any).__initialized)
      return
    ;(resetBtn as any).__initialized = true

    resetBtn.addEventListener('click', () => {
      // Refresh the preview iframe
      refreshPreview()

      // Show feedback animation
      resetIcon.style.transition = 'transform 0.5s ease'
      resetIcon.style.transform = 'rotate(-360deg)'
      setTimeout(() => {
        resetIcon.style.transform = ''
      }, 500)
    })
  }

  document.addEventListener('DOMContentLoaded', initResetButton)
  document.addEventListener('astro:page-load', initResetButton)
</script>
