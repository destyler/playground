---
import BaseLayout from '../layouts/BaseLayout.astro'
import MultiCdnRepl from '../components/repl/MultiCdnRepl.tsx'
---

<BaseLayout>
  <section class="desktop">
    <div class="window">
      <header class="window__bar">
        <div class="lights" aria-hidden="true">
          <span class="light light--red"></span>
          <span class="light light--amber"></span>
          <span class="light light--green"></span>
        </div>
        <div class="bar__title">
          <p class="eyebrow">Astro</p>
          <p class="title">CDN Multi-Framework REPL</p>
        </div>
      </header>

      <div class="window__body">
        <MultiCdnRepl client:only="react" />
      </div>
    </div>
  </section>

  <style>
    .desktop {
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 40px 20px;
    }

    .window {
      width: min(1180px, 100%);
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: blur(14px);
      border: 1px solid rgba(15, 23, 42, 0.08);
      border-radius: 28px;
      box-shadow: 0 30px 120px -60px rgba(15, 23, 42, 0.55);
      overflow: hidden;
    }

    .window__bar {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 14px 18px;
      background: linear-gradient(135deg, rgba(15, 23, 42, 0.08), rgba(15, 23, 42, 0.16));
      border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    }

    .lights {
      display: flex;
      gap: 8px;
      padding-right: 10px;
    }

    .light {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.2);
    }

    .light--red {
      background: #ff5f56;
    }

    .light--amber {
      background: #ffbd2f;
    }

    .light--green {
      background: #27c93f;
    }

    .bar__title {
      display: grid;
      gap: 6px;
    }

    .eyebrow {
      font-size: 12px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(15, 23, 42, 0.6);
      margin: 0;
    }

    .title {
      font-size: 18px;
      font-weight: 600;
      color: #0f172a;
      margin: 0;
    }

    .window__body {
      padding: 14px;
      background: linear-gradient(145deg, rgba(248, 250, 252, 0.92), rgba(255, 255, 255, 0.96));
    }
  </style>
</BaseLayout>
